<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BigFields"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Karoo data fields in digits as large as the cell allows."
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="STYLE"
            android:textColor="#888888"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <Spinner
            android:id="@+id/sp_style"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="NUMBER FONT"
            android:textColor="#888888"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <Spinner
            android:id="@+id/sp_font"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_label"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Show label and unit"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_banner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Leave room for the navigation banner"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_banner_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_diag"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Diagnostic log (test)"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_sample"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Show sample values (test)"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="BIG PAGES"
            android:textColor="#888888"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A Big Page field fills a whole data page with one or two rows of equal height. Put one Big Page field alone on a page, then choose its rows here."
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3" />

        <LinearLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_preview_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#888888"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="6dp"
            android:background="#222222"
            android:clipChildren="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="HOW TO USE"
            android:textColor="#888888"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="In the Karoo profile editor, pick fields from the BigFields extension: a Big Page for a whole page, or single Big fields to mix with native ones. Single fields available:"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/tv_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>
</ScrollView>
