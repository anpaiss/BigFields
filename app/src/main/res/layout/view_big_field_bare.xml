<?xml version="1.0" encoding="utf-8"?>
<!-- Campo grande senza didascalia. Il numero è un'immagine a un canale disegnata da
     NumberRenderer, colorata con setColorFilter: l'autosize di una TextView
     riempiva la riga di testo e non le cifre (prima prova 25/09). Tutte le
     misure sono in pixel (dimens.xml) perché CellGeometry calcola l'area del
     numero con gli stessi valori. I quattro layout hanno gli stessi id: sul
     Karoo setViewVisibility e setTextViewTextSize non vengono applicati. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/cell_pad_h"
    android:paddingEnd="@dimen/cell_pad_h"
    android:paddingTop="@dimen/cell_pad_top"
    android:paddingBottom="@dimen/cell_pad_bottom"
    android:background="#000000">

    <TextView
        android:id="@+id/tv_label"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <ImageView
        android:id="@+id/iv_value"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

</LinearLayout>
