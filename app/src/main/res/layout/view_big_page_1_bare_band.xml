<?xml version="1.0" encoding="utf-8"?>
<!-- Generato: campo pagina con 1 righe uguali, senza didascalie, fascia per il banner.
     Ogni riga ha fondo, didascalia e numero propri (id _1.._4). Un layout per
     combinazione perché sul Karoo setViewVisibility non viene applicato. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/cell_pad_h"
        android:paddingEnd="@dimen/cell_pad_h"
        android:paddingTop="@dimen/cell_pad_top"
        android:paddingBottom="@dimen/cell_pad_bottom"
        android:background="#000000">

        <TextView
            android:id="@+id/tv_label_1"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/iv_value_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Fascia libera per il banner "next cue" della navigazione, una sola in fondo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/banner_band" />

</LinearLayout>
